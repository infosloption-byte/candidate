generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum UserRole {
  ADMIN
  AGENCY
  INTERVIEWER
  INTERVIEWEE
}

enum AgencyStatus {
  ACTIVE
  INACTIVE
}

enum OnboardingStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  COMPLETED
}

enum CandidateSource {
  AGENCY_ADDED
  SELF_ONBOARDED
  BULK_IMPORTED
}

enum JobStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum ApplicationStatus {
  APPLIED
  SCREENING
  SHORTLISTED
  INTERVIEW
  SELECTED
  REJECTED
  WITHDRAWN
}

enum InterviewType {
  SCREENING
  TECHNICAL
  PRACTICAL
  FINAL
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum Recommendation {
  RECOMMENDED
  MAYBE
  NOT_RECOMMENDED
}

model Agency {
  id        String       @id @default(uuid()) @db.VarChar(36)
  name      String       @db.VarChar(160)
  slug      String       @unique @db.VarChar(100)
  status    AgencyStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  users      User[]
  jobs       Job[]
  candidates Candidate[]
  auditEvents AuditEvent[]
}

model User {
  id           String     @id @default(uuid()) @db.VarChar(36)
  agencyId     String?    @db.VarChar(36)
  candidateId  String?    @unique @db.VarChar(36)
  name         String     @db.VarChar(160)
  email        String     @unique @db.VarChar(191)
  passwordHash String     @db.VarChar(255)
  role         UserRole
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  agency        Agency?                 @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  candidate     Candidate?              @relation("CandidateAccount", fields: [candidateId], references: [id], onDelete: SetNull)
  interviews    InterviewParticipant[]
  evaluations   InterviewEvaluation[]
  sessions      Session[]
  auditEvents   AuditEvent[]            @relation("AuditActor")
  notifications Notification[]

  @@index([agencyId, role, active])
}

model Session {
  id        String   @id @default(uuid()) @db.VarChar(36)
  userId    String   @db.VarChar(36)
  tokenHash String   @unique @db.VarChar(64)
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Candidate {
  id               String           @id @default(uuid()) @db.VarChar(36)
  agencyId         String           @db.VarChar(36)
  reference        String           @db.VarChar(32)
  name             String           @db.VarChar(160)
  email            String?          @db.VarChar(191)
  phone            String?           @db.VarChar(60)
  profession       String?          @db.VarChar(120)
  experienceYears  Int?
  skills           Json
  onboardingStatus OnboardingStatus @default(NOT_STARTED)
  source           CandidateSource  @default(AGENCY_ADDED)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  agency       Agency          @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  account      User?           @relation("CandidateAccount")
  applications JobApplication[]
  documents    CandidateDocument[]

  @@unique([agencyId, reference])
  @@index([agencyId, name])
  @@index([agencyId, profession])
}

model CandidateDocument {
  id           String   @id @default(uuid()) @db.VarChar(36)
  candidateId  String   @db.VarChar(36)
  originalName String   @db.VarChar(180)
  mimeType     String   @db.VarChar(80)
  sizeBytes    Int
  storageKey   String   @unique @db.VarChar(120)
  createdAt    DateTime @default(now())

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId, createdAt])
}

model Job {
  id          String    @id @default(uuid()) @db.VarChar(36)
  agencyId    String    @db.VarChar(36)
  title       String    @db.VarChar(160)
  description String?   @db.Text
  location    String?   @db.VarChar(160)
  openings    Int       @default(1)
  status      JobStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  agency       Agency          @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  applications JobApplication[]
}

model JobApplication {
  id          String            @id @default(uuid()) @db.VarChar(36)
  jobId       String            @db.VarChar(36)
  candidateId String            @db.VarChar(36)
  status      ApplicationStatus @default(APPLIED)
  appliedAt   DateTime          @default(now())
  notes       String?           @db.Text
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  job        Job        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidate  Candidate  @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  interviews Interview[]

  @@unique([jobId, candidateId])
  @@index([jobId, status])
  @@index([candidateId, status])
}

model Interview {
  id            String          @id @default(uuid()) @db.VarChar(36)
  applicationId String          @db.VarChar(36)
  type          InterviewType
  status        InterviewStatus @default(SCHEDULED)
  scheduledAt   DateTime
  durationMins  Int             @default(30)
  location      String?         @db.VarChar(160)
  notes         String?         @db.Text
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  application JobApplication        @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  panel       InterviewParticipant[]
  evaluations InterviewEvaluation[]

  @@index([applicationId, scheduledAt])
  @@index([status, scheduledAt])
}

model InterviewParticipant {
  interviewId String   @db.VarChar(36)
  userId      String   @db.VarChar(36)
  assignedAt  DateTime @default(now())

  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([interviewId, userId])
  @@index([userId, assignedAt])
}

model InterviewEvaluation {
  id             String         @id @default(uuid()) @db.VarChar(36)
  interviewId    String         @db.VarChar(36)
  interviewerId  String         @db.VarChar(36)
  rating         Int
  recommendation Recommendation
  comments       String?        @db.Text
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  interviewer User      @relation(fields: [interviewerId], references: [id], onDelete: Cascade)

  @@unique([interviewId, interviewerId])
  @@index([interviewerId, createdAt])
}

model AuditEvent {
  id         String   @id @default(uuid()) @db.VarChar(36)
  actorId    String?  @db.VarChar(36)
  agencyId   String?  @db.VarChar(36)
  action     String   @db.VarChar(80)
  entityType String   @db.VarChar(80)
  entityId   String   @db.VarChar(36)
  summary    String   @db.VarChar(500)
  createdAt  DateTime @default(now())

  actor  User?   @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  agency Agency? @relation(fields: [agencyId], references: [id], onDelete: SetNull)

  @@index([agencyId, createdAt])
  @@index([actorId, createdAt])
  @@index([entityType, entityId, createdAt])
}

model Notification {
  id        String    @id @default(uuid()) @db.VarChar(36)
  userId    String    @db.VarChar(36)
  type      String    @db.VarChar(64)
  title     String    @db.VarChar(160)
  message   String    @db.VarChar(500)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}
