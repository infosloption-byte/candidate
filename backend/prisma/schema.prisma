generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum UserRole {
  ADMIN
  AGENCY
  INTERVIEWER
  INTERVIEWEE
}

enum AgencyStatus {
  ACTIVE
  INACTIVE
}

enum OnboardingStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  COMPLETED
}

enum CandidateSource {
  AGENCY_ADDED
  SELF_ONBOARDED
  BULK_IMPORTED
}

enum JobStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum InterviewType {
  SCREENING
  TECHNICAL
  PRACTICAL
  FINAL
}

enum InterviewStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum InterviewEvaluationStatus {
  DRAFT
  SUBMITTED
}

enum InterviewCriterionResponseType {
  SCORE
  TEXT
  SINGLE_SELECT
  MULTI_SELECT
  BOOLEAN
}

enum CandidateStatus {
  POOL
  READY_FOR_INTERVIEW
  INTERVIEW_SCHEDULED
  INTERVIEW_COMPLETED
  PASSED
  REJECTED
  ON_HOLD
  HIRED
  INACTIVE
}

model Agency {
  id        String       @id @default(uuid()) @db.VarChar(36)
  name      String       @db.VarChar(160)
  slug      String       @unique @db.VarChar(100)
  status    AgencyStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  users      User[]
  jobs       Job[]
  candidates Candidate[]
  auditEvents              AuditEvent[]
}

model User {
  id           String     @id @default(uuid()) @db.VarChar(36)
  agencyId     String?    @db.VarChar(36)
  candidateId  String?    @unique @db.VarChar(36)
  name         String     @db.VarChar(160)
  email        String     @unique @db.VarChar(191)
  passwordHash String     @db.VarChar(255)
  role         UserRole
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  agency        Agency?                 @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  candidate     Candidate?              @relation("CandidateAccount", fields: [candidateId], references: [id], onDelete: SetNull)
  interviews    InterviewParticipant[]
  evaluations   InterviewEvaluation[]
  sessions      Session[]
  auditEvents   AuditEvent[]            @relation("AuditActor")
  notifications Notification[]
  statusChanges CandidateStatusHistory[]

  @@index([agencyId, role, active])
}

model Session {
  id        String   @id @default(uuid()) @db.VarChar(36)
  userId    String   @db.VarChar(36)
  tokenHash String   @unique @db.VarChar(64)
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Candidate {
  id               String           @id @default(uuid()) @db.VarChar(36)
  agencyId         String           @db.VarChar(36)
  reference        String           @db.VarChar(32)
  name             String           @db.VarChar(160)
  email            String?          @db.VarChar(191)
  phone            String?          @db.VarChar(60)
  alternatePhone   String?          @db.VarChar(60)
  country          String?          @db.VarChar(100)
  passportNumber   String?          @db.VarChar(60)
  passportExpiry   DateTime?
  currentLocation  String?          @db.VarChar(160)
  availability     String?          @db.VarChar(80)
  visaStatus       String?          @db.VarChar(80)
  profession       String?          @db.VarChar(120)
  experienceYears  Int?
  skills           Json
  onboardingStatus OnboardingStatus @default(NOT_STARTED)
  source           CandidateSource  @default(AGENCY_ADDED)
  status           CandidateStatus  @default(POOL)
  statusUpdatedAt  DateTime         @default(now())
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  agency       Agency          @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  account      User?           @relation("CandidateAccount")
  documents    CandidateDocument[]
  interviews   Interview[]
  statusHistory CandidateStatusHistory[]

  @@unique([agencyId, reference])
  @@index([agencyId, name])
  @@index([agencyId, profession])
  @@index([agencyId, country])
  @@index([agencyId, passportNumber])
  @@index([agencyId, visaStatus])
  @@index([agencyId, availability])
}

model CandidateDocument {
  id           String   @id @default(uuid()) @db.VarChar(36)
  candidateId  String   @db.VarChar(36)
  originalName String   @db.VarChar(180)
  mimeType     String   @db.VarChar(80)
  sizeBytes    Int
  storageKey   String   @unique @db.VarChar(120)
  createdAt    DateTime @default(now())

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId, createdAt])
}

model Job {
  id          String    @id @default(uuid()) @db.VarChar(36)
  agencyId    String    @db.VarChar(36)
  title       String    @db.VarChar(160)
  description String?   @db.Text
  location    String?   @db.VarChar(160)
  openings    Int       @default(1)
  status      JobStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  agency     Agency      @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  interviews Interview[]

  @@index([agencyId, status])
}

model Interview {
  id            String          @id @default(uuid()) @db.VarChar(36)
  candidateId   String          @db.VarChar(36)
  jobId         String?         @db.VarChar(36)
  type          InterviewType
  status        InterviewStatus @default(SCHEDULED)
  scheduledAt   DateTime
  durationMins  Int             @default(30)
  location      String?         @db.VarChar(160)
  notes           String?        @db.Text
  criterionGroupId String?        @db.VarChar(36)
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  candidate         Candidate                     @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job               Job?                          @relation(fields: [jobId], references: [id], onDelete: SetNull)
  criterionGroup    InterviewCriterionGroup?      @relation(fields: [criterionGroupId], references: [id], onDelete: SetNull)
  criterionGroups   InterviewCriterionGroupAssignment[]
  panel             InterviewParticipant[]
  evaluations       InterviewEvaluation[]
  criterionAssignments InterviewCriterionAssignment[]

  @@index([candidateId, scheduledAt])
  @@index([criterionGroupId])
  @@index([jobId, scheduledAt])
  @@index([status, scheduledAt])
}

model InterviewParticipant {
  interviewId String   @db.VarChar(36)
  userId      String   @db.VarChar(36)
  assignedAt  DateTime @default(now())

  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([interviewId, userId])
  @@index([userId, assignedAt])
}

model InterviewEvaluation {
  id             String                    @id @default(uuid()) @db.VarChar(36)
  interviewId    String                    @db.VarChar(36)
  interviewerId  String                    @db.VarChar(36)
  status         InterviewEvaluationStatus @default(DRAFT)
  comments       String?                   @db.Text
  submittedAt    DateTime?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  interviewer User      @relation(fields: [interviewerId], references: [id], onDelete: Cascade)
  scores      InterviewEvaluationScore[]
  responses   InterviewEvaluationResponse[]

  @@unique([interviewId, interviewerId])
  @@index([interviewerId, status, createdAt])
}

model InterviewCriterionGroup {
  id          String   @id @default(uuid()) @db.VarChar(36)
  name        String   @db.VarChar(160)
  category    String?  @db.VarChar(120)
  description String?  @db.VarChar(500)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  criteria    InterviewCriterionGroupItem[]
  interviews  Interview[]
  interviewAssignments InterviewCriterionGroupAssignment[]
  assignments InterviewCriterionAssignment[]

}

model InterviewCriterionGroupAssignment {
  interviewId String @db.VarChar(36)
  groupId     String @db.VarChar(36)
  sortOrder   Int    @default(0)

  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  group     InterviewCriterionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([interviewId, groupId])
  @@index([groupId, sortOrder])
}

model InterviewCriterionGroupItem {
  groupId     String @db.VarChar(36)
  criterionId String @db.VarChar(36)
  sortOrder   Int    @default(0)

  group     InterviewCriterionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  criterion InterviewCriterion      @relation(fields: [criterionId], references: [id], onDelete: Cascade)

  @@id([groupId, criterionId])
  @@index([criterionId])
}

model InterviewCriterionAssignment {
  id          String   @id @default(uuid()) @db.VarChar(36)
  interviewId String   @db.VarChar(36)
  criterionId String   @db.VarChar(36)
  groupId     String?  @db.VarChar(36)
  name        String   @db.VarChar(120)
  description String?  @db.VarChar(500)
  maxPoints    Int
  responseType InterviewCriterionResponseType @default(SCORE)
  required     Boolean @default(true)
  options      Json?
  sortOrder    Int      @default(0)
  createdAt   DateTime @default(now())

  interview  Interview          @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  criterion  InterviewCriterion @relation(fields: [criterionId], references: [id], onDelete: Restrict)
  group      InterviewCriterionGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@unique([interviewId, criterionId])
  @@index([interviewId, sortOrder])
  @@index([criterionId])
}

model InterviewCriterion {
  id          String   @id @default(uuid()) @db.VarChar(36)
  name        String   @db.VarChar(120)
  description String?  @db.VarChar(500)
  maxPoints    Int      @default(5)
  responseType InterviewCriterionResponseType @default(SCORE)
  required     Boolean @default(true)
  options      Json?
  active       Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  scores InterviewEvaluationScore[]
  groupItems InterviewCriterionGroupItem[]
  assignments InterviewCriterionAssignment[]
  responses   InterviewEvaluationResponse[]

}

model InterviewEvaluationScore {
  id           String @id @default(uuid()) @db.VarChar(36)
  evaluationId String @db.VarChar(36)
  criterionId  String @db.VarChar(36)
  points       Int

  evaluation InterviewEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  criterion  InterviewCriterion  @relation(fields: [criterionId], references: [id], onDelete: Cascade)

  @@unique([evaluationId, criterionId])
  @@index([criterionId])
}

model InterviewEvaluationResponse {
  id              String  @id @default(uuid()) @db.VarChar(36)
  evaluationId    String  @db.VarChar(36)
  criterionId     String  @db.VarChar(36)
  textValue       String? @db.Text
  selectedOptions Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  evaluation InterviewEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  criterion  InterviewCriterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)

  @@unique([evaluationId, criterionId])
  @@index([criterionId])
}

model CandidateStatusHistory {
  id          String         @id @default(uuid()) @db.VarChar(36)
  candidateId String         @db.VarChar(36)
  fromStatus  CandidateStatus?
  toStatus    CandidateStatus
  reason      String?        @db.VarChar(500)
  changedById String?        @db.VarChar(36)
  createdAt   DateTime       @default(now())

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  changedBy User?     @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([candidateId, createdAt])
}

model AuditEvent {
  id         String   @id @default(uuid()) @db.VarChar(36)
  actorId    String?  @db.VarChar(36)
  agencyId   String?  @db.VarChar(36)
  action     String   @db.VarChar(80)
  entityType String   @db.VarChar(80)
  entityId   String   @db.VarChar(36)
  summary    String   @db.VarChar(500)
  createdAt  DateTime @default(now())

  actor  User?   @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  agency Agency? @relation(fields: [agencyId], references: [id], onDelete: SetNull)

  @@index([agencyId, createdAt])
  @@index([actorId, createdAt])
  @@index([entityType, entityId, createdAt])
}

model Notification {
  id        String    @id @default(uuid()) @db.VarChar(36)
  userId    String    @db.VarChar(36)
  type      String    @db.VarChar(64)
  title     String    @db.VarChar(160)
  message   String    @db.VarChar(500)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}
